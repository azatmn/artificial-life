@startuml usecase
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
left to right direction

actor "Пользователь" as user

rectangle "Искусственная жизнь" {
  usecase "Запустить симуляцию" as UC1
  usecase "Приостановить симуляцию" as UC2
  usecase "Выполнить один шаг" as UC3
  usecase "Выполнить N шагов\n(консоль)" as UC4
  usecase "Сбросить поле" as UC5
  usecase "Изменить скорость" as UC6
  usecase "Настроить параметры" as UC7
  usecase "Проверить параметры" as UC8
  usecase "Показать ошибки ввода" as UC9
  usecase "Наблюдать поле,\nсчётчики и график" as UC10
  usecase "Получить справку\n(консоль)" as UC11
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5
user --> UC6
user --> UC7
user --> UC10
user --> UC11
UC7 ..> UC8 : <<include>>
UC9 ..> UC8 : <<extend>>
@enduml
